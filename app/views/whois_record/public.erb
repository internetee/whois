<%- if json['disclaimer'].present? && json['disclaimer'].is_a?(String) -%>
<%= json['disclaimer'].scan(/\S.{0,72}\S(?=\s|$)|\S+/).join("\n") %>
<%- elsif json['disclaimer'].present? && json['disclaimer'].is_a?(Hash) -%>
<%= json.dig('disclaimer', I18n.locale.to_s).scan(/\S.{0,72}\S(?=\s|$)|\S+/).join("\n") %>
<%- end -%>

Estonia .ee Top Level Domain WHOIS server

Domain:
name:       <%= json['name'] %>
<%- for st in Array(json['status']) -%>
status:     <%= st %>
<%- end -%>
registered: <%= json['registered'].to_s.tr('T',' ').sub('+', ' +') %>
expire:     <%= json['expire'].to_s.tr('T',' ').sub('+', ' +') %>

Registrant:
name:       <%= registrant.volunteered?(:name) ? registrant.name : registrant_name_mask %>
type:       <%= registrant_type %>
email:      <%= registrant.volunteered?(:email) ? registrant.email : registrant_field_mask %>
phone:      <%= registrant.volunteered?(:phone) ? registrant.phone : registrant_field_mask %>

<%- if admin_contacts.any? -%>
Administrative contact:
<%- admin_contacts.each do |contact| -%>
name:       <%= contact.volunteered?(:name) ? contact.name : 'Not Disclosed' %>
email:      <%= contact.volunteered?(:email) ? contact.email : 'Not Disclosed' %>
phone:      <%= contact.volunteered?(:phone) ? contact.phone : 'Not Disclosed' %>
<%- end -%>
<%- end -%>

<%- if tech_contacts.any? -%>
Technical contact:
<%- tech_contacts.each do |contact| -%>
name:       <%= contact.volunteered?(:name) ? contact.name : tech_contact_mask(contact) %>
email:      <%= contact.volunteered?(:email) ? contact.email : tech_contact_mask(contact) %>
phone:      <%= contact.volunteered?(:phone) ? contact.phone : tech_contact_mask(contact) %>
<%- end -%>
<%- end -%>

Registrar:
name:       <%= json['registrar'] %>
url:        <%= json['registrar_website'] %>
phone:      <%= json['registrar_phone'] %>
<%- if json['registrar_email'].present? -%>
email:      <%= json['registrar_email'] %>
<%- end -%>
<%- if json['registrar_address'].present? -%>
address:    <%= json['registrar_address'] %>
<%- end -%>

<%- if json['nameserver_records'].present? -%>
Name servers:
<%- for ns in json['nameserver_records'] -%>
nserver:   <%= ([ns['hostname']] + Array(ns['ipv4']) + Array(ns['ipv6'])).join(' ') %>
<%- end -%>

<%- elsif json['nameserver_records'].nil? && json['nameservers'].present? -%>
Name servers:
<%- for server in json['nameservers'] -%>
nserver:   <%= server %>
<%- end -%>

<%- end -%>
<%- if json['dnssec_keys'].present? -%>
DNSSEC:
<%- for key in json['dnssec_keys'] -%>
dnskey:   <%= key %>
<%- end -%>
<%- end -%>

Estonia .ee Top Level Domain WHOIS server
More information at http://internet.ee
